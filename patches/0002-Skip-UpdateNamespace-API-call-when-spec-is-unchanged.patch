 	var state namespaceResourceModel
diff --git a/internal/provider/namespace_spec_unchanged_test.go b/internal/provider/namespace_spec_unchanged_test.go
new file mode 100644
index 0000000..a871a42
--- /dev/null
+++ b/internal/provider/namespace_spec_unchanged_test.go
@@ -0,0 +1,64 @@
+package provider
+
+import (
+	"testing"
+
+	namespacev1 "go.temporal.io/cloud-sdk/api/namespace/v1"
+)
+
+func TestIsNamespaceSpecUnchanged(t *testing.T) {
+	// Shape returned by GetNamespace for an API-key namespace with defaults.
+	current := func() *namespacev1.NamespaceSpec {
+		return &namespacev1.NamespaceSpec{
+			Name:          "ns",
+			Regions:       []string{"gcp-us-west1"},
+			RetentionDays: 90,
+			MtlsAuth:      &namespacev1.MtlsAuthSpec{},
+			ApiKeyAuth:    &namespacev1.ApiKeyAuthSpec{Enabled: true},
+			CodecServer: &namespacev1.CodecServerSpec{
+				CustomErrorMessage: &namespacev1.CodecServerSpec_CustomErrorMessage{
+					Default: &namespacev1.CodecServerSpec_CustomErrorMessage_ErrorMessage{},
+				},
+			},
+			Lifecycle:        &namespacev1.LifecycleSpec{},
+			HighAvailability: &namespacev1.HighAvailabilitySpec{},
+			Replicas:         []*namespacev1.ReplicaSpec{{Region: "gcp-us-west1"}},
+		}
+	}
+	desired := func() *namespacev1.NamespaceSpec {
+		return &namespacev1.NamespaceSpec{
+			Name:          "ns",
+			Regions:       []string{"gcp-us-west1"},
+			RetentionDays: 90,
+			ApiKeyAuth:    &namespacev1.ApiKeyAuthSpec{Enabled: true},
+		}
+	}
+
+	if !isNamespaceSpecUnchanged(current(), desired()) {
+		t.Error("expected server defaults to compare equal to an unchanged desired spec")
+	}
+
+	retention := desired()
+	retention.RetentionDays = 30
+	if isNamespaceSpecUnchanged(current(), retention) {
+		t.Error("expected retention change to be detected")
+	}
+
+	description := desired()
+	description.Description = "changed"
+	if isNamespaceSpecUnchanged(current(), description) {
+		t.Error("expected description change to be detected")
+	}
+
+	lifecycle := desired()
+	lifecycle.Lifecycle = &namespacev1.LifecycleSpec{EnableDeleteProtection: true}
+	if isNamespaceSpecUnchanged(current(), lifecycle) {
+		t.Error("expected lifecycle change to be detected")
+	}
+
+	c := current()
+	isNamespaceSpecUnchanged(c, desired())
+	if c.Replicas == nil || c.MtlsAuth == nil {
+		t.Error("expected inputs to be left unmodified")
+	}
+}
