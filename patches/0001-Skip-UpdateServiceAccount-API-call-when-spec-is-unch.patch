From 56c773b56b9d7d7c9086c826c8fe493415f692cb Mon Sep 17 00:00:00 2001
From: Brian Lee <briandl92391@gmail.com>
Date: Tue, 19 May 2026 13:55:18 -0700
Subject: [PATCH] Skip UpdateServiceAccount API call when spec is unchanged

The Temporal Cloud API returns InvalidArgument("nothing to change") for
no-op updates. This surfaces as a hard error when a provider version
upgrade causes Pulumi to trigger an update even though the resource
configuration has not changed.

Add a proto.Equal check before calling UpdateServiceAccount: if the
desired spec matches what the API already has, write the current state
back directly without making an API call.
---
 internal/provider/service_account_resource.go | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/internal/provider/service_account_resource.go b/internal/provider/service_account_resource.go
index 145e5f0..b01f5e8 100644
--- a/internal/provider/service_account_resource.go
+++ b/internal/provider/service_account_resource.go
@@ -23,6 +23,7 @@ import (
 	"github.com/hashicorp/terraform-plugin-log/tflog"
 	"google.golang.org/grpc/codes"
 	"google.golang.org/grpc/status"
+	"google.golang.org/protobuf/proto"
 
 	cloudservicev1 "go.temporal.io/cloud-sdk/api/cloudservice/v1"
 	identityv1 "go.temporal.io/cloud-sdk/api/identity/v1"
@@ -303,6 +304,19 @@ func (r *serviceAccountResource) Update(ctx context.Context, req resource.Update
 		return
 	}
 
+	// Skip the API call when nothing has actually changed. The Temporal Cloud
+	// API returns InvalidArgument("nothing to change") for no-op updates (e.g.
+	// when a provider version upgrade causes Pulumi to issue an update despite
+	// the resource configuration being identical). Detect this case via proto
+	// equality and short-circuit by writing the current state back directly.
+	if proto.Equal(currentServiceAccount.ServiceAccount.GetSpec(), spec) {
+		resp.Diagnostics.Append(updateServiceAccountModelFromSpec(ctx, &plan, currentServiceAccount.ServiceAccount)...)
+		if !resp.Diagnostics.HasError() {
+			resp.Diagnostics.Append(resp.State.Set(ctx, plan)...)
+		}
+		return
+	}
+
 	svcResp, err := r.client.CloudService().UpdateServiceAccount(ctx, &cloudservicev1.UpdateServiceAccountRequest{
 		ServiceAccountId: plan.ID.ValueString(),
 		Spec:             spec,
-- 
2.54.0

